#!/usr/bin/env bash
# Git pre-push hook: runs the toolkit's dependency-audit (only when a manifest
# or lockfile changed) and test-impact-selector skills headlessly through
# `claude -p` before a push.
#
# Install:  cp hooks/pre-push .git/hooks/pre-push && chmod +x .git/hooks/pre-push
# Bypass:   git push --no-verify   (or SKIP_CLAUDE_PREPUSH=1 git push)
#
# Fail-closed: the push is blocked unless the model's last line is exactly
# "GATE: PASS". A missing `claude` binary is the one exception: it is reported
# and the push continues, so the hook never bricks a machine without Claude Code.

set -uo pipefail

[ "${SKIP_CLAUDE_PREPUSH:-}" = "1" ] && exit 0
if ! command -v claude >/dev/null 2>&1; then
  echo "pre-push: claude CLI not found, skipping toolkit checks" >&2
  exit 0
fi

# Plugin skills are namespaced; set CLAUDE_TOOLKIT_NS="" if you copied the skills instead.
NS="${CLAUDE_TOOLKIT_NS-engineering-toolkit:}"
ZERO=0000000000000000000000000000000000000000
READ_ONLY_TOOLS="Read,Grep,Glob,Bash(git diff:*),Bash(git log:*),Bash(git show:*),Bash(npm audit:*),Bash(pip-audit:*),Bash(govulncheck:*),Bash(cargo audit:*)"

run_gate() { # $1 = label, $2 = prompt
  local out
  out=$(claude -p "$2

End your answer with one final line that is exactly 'GATE: PASS' or 'GATE: BLOCK'." \
    --allowedTools "$READ_ONLY_TOOLS" 2>&1)
  echo "$out"
  if [ "$(printf '%s\n' "$out" | tail -n 1 | tr -d '[:space:]')" != "GATE:PASS" ]; then
    echo "pre-push: $1 did not pass — push blocked (bypass with --no-verify)" >&2
    return 1
  fi
}

status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue # branch deletion
  if [ "$remote_sha" = "$ZERO" ]; then
    range="$(git merge-base "$local_sha" origin/HEAD 2>/dev/null || git rev-list --max-parents=0 "$local_sha" | tail -n 1)..$local_sha"
  else
    range="$remote_sha..$local_sha"
  fi
  changed=$(git diff --name-only "$range")
  [ -z "$changed" ] && continue

  if printf '%s\n' "$changed" | grep -Eq '(^|/)(package(-lock)?\.json|yarn\.lock|pnpm-lock\.yaml|requirements[^/]*\.txt|poetry\.lock|Pipfile\.lock|go\.(mod|sum)|Cargo\.(toml|lock)|Gemfile\.lock|composer\.(json|lock))$'; then
    run_gate "dependency-audit" "/${NS}dependency-audit Audit only the dependency changes in git range $range. Block only on a reachable critical/high vulnerability introduced by this range." || status=1
  fi

  run_gate "test-impact-selector" "/${NS}test-impact-selector Select the tests covering git range $range and list the command to run them. Block only if the selection cannot be determined." || status=1
done

exit $status
